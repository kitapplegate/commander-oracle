[Unit]
Description=Commander Oracle daily price pipeline (one-shot)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=oracle
Group=oracle
WorkingDirectory=/opt/commander-oracle/app
ExecStart=/opt/commander-oracle/app/.venv/bin/python -m oracle.daily
Nice=10
# Shares the VPS with other live apps: cap memory and time.
MemoryMax=1500M
TimeoutStartSec=30min
